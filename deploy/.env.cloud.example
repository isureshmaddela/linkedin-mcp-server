# Environment for the hosted build (docker-compose.cloud.yml reads a copy of this file named .env.cloud).
# Copy it:   cp deploy/.env.cloud.example deploy/.env.cloud     (do NOT commit the copy)
# Every name here is read by aira_cloud/config.py, __main__.py or app.py; docs/multitenant-operations.md explains each.

# --- service ---------------------------------------------------------------------------------------
# The image already sets these three; they are listed so the file is a complete reference.
AIRA_CLOUD_DATA=/data
AIRA_CLOUD_HOST=0.0.0.0
AIRA_CLOUD_PORT=8780
AIRA_CLOUD_BASE_URL=http://127.0.0.1:8780
# Comma-separated host names the service answers to (loopback is always allowed). Required in production.
AIRA_CLOUD_ALLOWED_HOSTS=
AIRA_CLOUD_REGION=local-1
AIRA_CLOUD_SECURITY_CONTACT=security@example.invalid
# Behind a proxy that sets X-Forwarded-For, turn this on so rate limits see the client address.
AIRA_CLOUD_TRUST_PROXY=0
AIRA_CLOUD_LOG_LEVEL=INFO
AIRA_CLOUD_JSON_LOGS=1

# --- secrets ---------------------------------------------------------------------------------------
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it outside the data volume and back it up: without it the documents cannot be read.
AIRA_CLOUD_MASTER_KEY=
# Creates the first platform admin on start when no operator exists. Remove after the first start.
AIRA_CLOUD_OPERATOR_EMAIL=
AIRA_CLOUD_OPERATOR_PASSWORD=
# The platform's own SerpApi key for the "pooled searches" option on Team and Enterprise (optional).
AIRA_POOLED_SERPAPI_KEY=

# --- billing ---------------------------------------------------------------------------------------
# standin: a built-in checkout page that moves no money (development only). stripe: production.
AIRA_CLOUD_BILLING=standin
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# --- mail ------------------------------------------------------------------------------------------
# smtp://user:pass@host:587 (STARTTLS), smtps://user:pass@host:465, or smtp://host:25 (no STARTTLS).
# Empty: messages are only stored in the database and nothing is sent.
AIRA_CLOUD_SMTP_URL=smtp://mailpit:25
AIRA_CLOUD_MAIL_FROM=Aira <no-reply@example.invalid>

# --- model -----------------------------------------------------------------------------------------
# ollama | anthropic | openai (an OpenAI-compatible endpoint)
AIRA_CLOUD_MODEL_PROVIDER=ollama
AIRA_CLOUD_MODEL_URL=
AIRA_CLOUD_MODEL_KEY=
AIRA_CLOUD_MODEL_NAME=

# --- document storage ------------------------------------------------------------------------------
# local: files under the data volume.  s3: an S3-compatible bucket (path-style, Signature V4).
AIRA_CLOUD_STORAGE=s3
AIRA_CLOUD_S3_ENDPOINT=http://s3:8333
AIRA_CLOUD_S3_BUCKET=aira-documents
AIRA_CLOUD_S3_REGION=us-east-1
AIRA_CLOUD_S3_ACCESS_KEY=aira-s3
AIRA_CLOUD_S3_SECRET_KEY=change-me-s3-secret

# --- optional: serve TLS from the process instead of a proxy ---------------------------------------
AIRA_CLOUD_TLS_CERT=
AIRA_CLOUD_TLS_KEY=

# --- worker agents and remote sign-in ----------------------------------------------------------------
# A worker host that holds LinkedIn sessions runs `python -m aira_cloud worker --agent-port ...`; the gateway
# forwards LinkedIn-bound requests to it, signed with the shared secret (32+ random characters).
AIRA_CLOUD_AGENT_SECRET=
# The remote sign-in broker's own secret (32+ random characters, different from the agent secret). Empty switches the
# broker's validate and event routes off.
AIRA_CLOUD_BROKER_SECRET=
AIRA_CLOUD_AGENT_HOST=0.0.0.0
AIRA_CLOUD_AGENT_PORT=8795
# The URL the gateway uses to reach this host's agent (published in its heartbeat).
AIRA_CLOUD_AGENT_URL=http://worker-1:8795
# Remote-desktop gateway that opens a candidate's browser for LinkedIn sign-in (empty: sign in on the host).
AIRA_CLOUD_REMOTE_LOGIN_URL=

# How many proxies in front of the app append to X-Forwarded-For (the client address is that many entries from the right).
AIRA_CLOUD_TRUSTED_PROXY_HOPS=1
# Development only: allow organization-supplied URLs (SSO, model endpoint) to point at loopback http. Never in production.
AIRA_CLOUD_ALLOW_LOCAL_URLS=0

# --- the sign-in broker (python -m aira_cloud broker), on the worker host that holds the LinkedIn profiles ---------
AIRA_CLOUD_BROKER_HOST=127.0.0.1
AIRA_CLOUD_BROKER_PORT=8790
# The web tier the broker calls (empty: AIRA_CLOUD_BASE_URL).
AIRA_CLOUD_BROKER_APP_URL=
AIRA_CLOUD_BROKER_SESSION_SECONDS=600
AIRA_CLOUD_BROKER_MAX_SESSIONS=4
AIRA_CLOUD_BROKER_START_URL=https://www.linkedin.com/login
# Extra hosts the private browser may navigate to, comma separated (linkedin.com is always allowed).
AIRA_CLOUD_BROKER_ALLOWED_HOSTS=
AIRA_CLOUD_BROKER_SIGNED_IN_COOKIE=li_at
AIRA_CLOUD_BROKER_SIGNED_IN_DOMAIN=linkedin.com

# --- master key custody -------------------------------------------------------------------------------
# local: AIRA_CLOUD_MASTER_KEY above, or a generated file. aws: AWS KMS. vault: HashiCorp Vault transit.
# With a KMS the master key never leaves it; an outage stops work that needs a key (503), it never falls back.
# To move between providers use `python -m aira_cloud rewrap-keys` (the old provider goes in AIRA_CLOUD_*_OLD).
AIRA_CLOUD_KMS=local
AIRA_CLOUD_KMS_KEY_ID=
AIRA_CLOUD_KMS_ENDPOINT=
AIRA_CLOUD_KMS_REGION=us-east-1
AIRA_CLOUD_KMS_ACCESS_KEY=
AIRA_CLOUD_KMS_SECRET_KEY=
AIRA_CLOUD_KMS_SESSION_TOKEN=
AIRA_CLOUD_KMS_VAULT_ADDR=
AIRA_CLOUD_KMS_VAULT_TOKEN=
AIRA_CLOUD_KMS_VAULT_MOUNT=transit
AIRA_CLOUD_KMS_VAULT_NAMESPACE=
AIRA_CLOUD_KMS_CACHE_SECONDS=300

# --- control-plane database ---------------------------------------------------------------------
# sqlite (default: one file under AIRA_CLOUD_DATA) or postgres. With postgres, row-level security applies; see
# docs/multitenant-operations.md "PostgreSQL control plane" for the three roles and their setup SQL.
AIRA_CLOUD_DB=sqlite
# application role (aira_app): tenant requests and jobs
AIRA_CLOUD_DATABASE_URL=
# platform role (aira_platform, BYPASSRLS): sign-in, webhooks, scheduler, operator actions, backups
AIRA_CLOUD_DATABASE_PLATFORM_URL=
# owner role (aira_owner): applies migrations, guards, grants and policies
AIRA_CLOUD_DATABASE_ADMIN_URL=
AIRA_CLOUD_DATABASE_POOL_SIZE=24
